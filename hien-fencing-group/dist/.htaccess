# Hien Fencing Group — lives under public_html/kaamtasker.com/hien-fencing-group/
# Same Namecheap host as the other demo sites. Do not overwrite any other /<slug>/ folder.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /hien-fencing-group/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /hien-fencing-group/index.html [L]
</IfModule>
