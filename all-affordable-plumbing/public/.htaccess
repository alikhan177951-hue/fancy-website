# All Affordable Plumbing — lives under public_html/kaamtasker.com/all-affordable-plumbing/
# Same Namecheap host as the other demo sites. Do not overwrite any other /<slug>/ folder.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /all-affordable-plumbing/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /all-affordable-plumbing/index.html [L]
</IfModule>
